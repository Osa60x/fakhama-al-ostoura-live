    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "lighthouse": "^13.4.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
