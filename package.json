    "test:e2e:ui": "playwright test --ui",
    "audit:production": "node scripts/audit-production.mjs",
    "qa:browser-matrix": "node scripts/browser-matrix.mjs",
    "qa:admin-browser-matrix": "AUDIT_URL=https://gold.osa60x.workers.dev/?admin=1&invite=1 node scripts/browser-matrix.mjs",
    "deploy": "pnpm build && wrangler deploy",
    "dev:worker": "pnpm build && wrangler dev --assets dist",
